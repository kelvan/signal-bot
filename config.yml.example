---
signal:
  number: "+<your phone number>"

# optional, "ollama" (default) or "openai" for any OpenAI-compatible server
# (llama.cpp, vLLM, LM Studio, ...)
llm:
  backend: "ollama"
  # optional, default sampling temperature, the server default is used if unset
  temperature: 0.8

# only used with the ollama backend
ollama:
  # optional
  host: "127.0.0.1:11434"
  # optional, how long (seconds) to keep the model loaded after a request; -1 keeps it loaded forever
  keep_alive: -1
  # optional, whether to let thinking-capable models reason before answering
  think: false
  # optional, context window size passed to ollama
  num_ctx: 2048

# only used with the openai backend
openai:
  base_url: "http://127.0.0.1:8000/v1"
  # optional
  api_key: ""

# optional
bot:
  personalities:
    - name: "Nerd"
      trigger: "hey nerd"
      model: "qwen3.5:4b"
      instructions: "You are a nerd, make answers nerdy, include nerdy cliches, make answers patronising, in-deth answers"
      # optional, overrides llm.temperature
      temperature: 0.5
      example_question: "What is a llm?"
